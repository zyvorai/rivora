FROM golang:1.27-bookworm AS go-builder
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=${VERSION}" -o /out/rivora-controller ./cmd/rivora-controller

FROM gcr.io/distroless/static-debian12
COPY --from=go-builder /out/rivora-controller /usr/local/bin/rivora-controller
ENTRYPOINT ["/usr/local/bin/rivora-controller"]

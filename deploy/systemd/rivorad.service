[Unit]
Description=Rivora load balancer daemon
Documentation=https://zyvor.dev/rivora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rivorad -config /etc/rivora/config.yaml -bpf-dir /usr/local/share/rivora/bpf
# The local API (127.0.0.1:9870 by default) is plain HTTP and unauthenticated
# unless these are set. Prefer an EnvironmentFile with restrictive
# permissions over inlining the key here. See README.md#securing-the-api.
#Environment=RIVORA_API_KEY=change-me
#Environment=RIVORA_TLS_SELF_SIGNED=1
#Environment=RIVORA_TLS_CERT=/etc/rivora/tls.crt
#Environment=RIVORA_TLS_KEY=/etc/rivora/tls.key
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
User=root

[Install]
WantedBy=multi-user.target

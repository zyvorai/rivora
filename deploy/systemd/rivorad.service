[Unit]
Description=Rivora load balancer daemon
Documentation=https://zyvor.dev/rivora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/rivora/rivorad.env
# Dummy dataplane iface so XDP never attaches to the public NIC (eno8303 /
# Cilium host). Safe for API-only / lab remote access; replace interface
# in /etc/rivora/config.yaml when you wire real VIPs.
ExecStartPre=-/usr/sbin/ip link add rivora0 type dummy
ExecStartPre=-/usr/sbin/ip link set rivora0 up
ExecStart=/usr/local/bin/rivorad -config /etc/rivora/config.yaml -bpf-dir /usr/local/share/rivora/bpf
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
# Needed for ExecStartPre ip link + BPF attach when AmbientCapabilities
# alone is insufficient on some distros.
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
User=root

[Install]
WantedBy=multi-user.target
